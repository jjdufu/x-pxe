# sushy-emulator 配置模板；lab/run.sh 渲染 @UUID@ 与 @WORK@ 后写入 lab/work/sushy/emulator.conf
SUSHY_EMULATOR_LISTEN_IP = '10.77.0.1'
SUSHY_EMULATOR_LISTEN_PORT = 8000
SUSHY_EMULATOR_SSL_CERT = '@WORK@/sushy/cert.pem'
SUSHY_EMULATOR_SSL_KEY = '@WORK@/sushy/key.pem'
SUSHY_EMULATOR_AUTH_FILE = '@WORK@/sushy/htpasswd'
SUSHY_EMULATOR_LIBVIRT_URI = 'qemu:///system'
SUSHY_EMULATOR_ALLOWED_INSTANCES = ['@UUID@']
SUSHY_EMULATOR_BOOT_LOADER_MAP = {
    'UEFI': {'x86_64': '/usr/share/OVMF/OVMF_CODE_4M.fd'},
    'Legacy': {'x86_64': None},
}
SUSHY_EMULATOR_VMEDIA_DEVICES = {
    'Cd': {'Name': 'Virtual CD', 'MediaTypes': ['CD', 'DVD']},
}
