<!-- Redfish 场景的 libvirt 域模板；lab/lib/redfish.sh 渲染 @...@ 占位符（XPXE_LAB_ACCEL=tcg 时 @DOMTYPE@=qemu、@CPUMODE@=maximum） -->
<domain type='@DOMTYPE@'>
  <name>vm-redfish</name>
  <uuid>@UUID@</uuid>
  <memory unit='MiB'>2048</memory>
  <vcpu>2</vcpu>
  <os>
    <type arch='x86_64' machine='q35'>hvm</type>
    <loader readonly='yes' type='pflash'>/usr/share/OVMF/OVMF_CODE_4M.fd</loader>
    <nvram template='/usr/share/OVMF/OVMF_VARS_4M.fd'>@VM@/vars.fd</nvram>
    <boot dev='hd'/>
  </os>
  <features><acpi/><apic/></features>
  <cpu mode='@CPUMODE@'/>
  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2'/>
      <source file='@VM@/sys.qcow2'/>
      <target dev='vda' bus='virtio'/>
      <serial>SYS0001</serial>
    </disk>
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <target dev='sda' bus='sata'/>
      <readonly/>
    </disk>
    <interface type='bridge'>
      <source bridge='br-lab'/>
      <mac address='@MAC@'/>
      <model type='virtio'/>
    </interface>
    <serial type='file'><source path='@VM@/serial.log'/><target port='0'/></serial>
    <console type='file'><source path='@VM@/serial.log'/><target type='serial' port='0'/></console>
  </devices>
</domain>
