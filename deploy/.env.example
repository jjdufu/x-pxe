# 复制为 deploy/.env 后按实际环境修改。不要把 .env 或 secrets/ 下的文件提交到仓库。

# 镜像标签（docker build -t x-pxe:<标签>；建议用 git describe 的输出）
XPXE_VERSION=v1.0.0

# 目标机可达的引导地址（宿主机在 PXE 网段上的 IP + 8080 端口，写全）
XPXE_BOOT_BASE_URL=http://192.168.2.3:8080

# bootnet 允许应答的网卡（逗号分隔）；仅 Redfish 时也需填写（用于现网 DHCP 探测）
XPXE_BOOTNET_ALLOWED_IFACES=ens192

# 离线模式：true 时禁用官方源获取，只能上传资产
XPXE_OFFLINE=false

# 日志级别：error | warn | info | debug
XPXE_LOG=info

# 可选：管理端 HTTPS（把证书与私钥作为 secret 挂入后填写容器内路径，见 docs/ops.md “证书”）
# XPXE_TLS_CERT_FILE=/run/secrets/xpxe_tls_cert
# XPXE_TLS_KEY_FILE=/run/secrets/xpxe_tls_key

# 可选：管理端/引导端发布端口（默认 8088/8080；如需只发布到管理网段可写成 192.168.10.5:8088）
# XPXE_ADMIN_PUBLISH=8088
# XPXE_BOOT_PUBLISH=8080
